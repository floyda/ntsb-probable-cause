{
  "case": {
    "$defs": {
      "Aircraft": {
        "additionalProperties": false,
        "description": "The aircraft as category and engines. Never make, model or registration.",
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "aircrafts[0].aircraftCategory, e.g. 'Airplane'.",
            "title": "Category"
          },
          "engine_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "aircrafts[0].engines[0].engineType.",
            "title": "Engine Type"
          },
          "engines": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "aircrafts[0].aircraftNumberOfEngines.",
            "title": "Engines"
          }
        },
        "required": [
          "category",
          "engines",
          "engine_type"
        ],
        "title": "Aircraft",
        "type": "object"
      },
      "Answer": {
        "additionalProperties": false,
        "description": "Ellery's answer.",
        "properties": {
          "abstained": {
            "title": "Abstained",
            "type": "boolean"
          },
          "cause": {
            "title": "Cause",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "findings": {
            "items": {
              "$ref": "#/$defs/Code"
            },
            "title": "Findings",
            "type": "array"
          },
          "occurrence": {
            "items": {
              "$ref": "#/$defs/Code"
            },
            "title": "Occurrence",
            "type": "array"
          }
        },
        "required": [
          "occurrence",
          "findings",
          "cause",
          "confidence",
          "abstained"
        ],
        "title": "Answer",
        "type": "object"
      },
      "Belief": {
        "additionalProperties": false,
        "description": "The agent's belief at one checkpoint.",
        "properties": {
          "account": {
            "description": "Ellery's evidence_narrative after the names step: the account that takes the place of the investigator's factual narrative.",
            "title": "Account",
            "type": "string"
          },
          "cause": {
            "title": "Cause",
            "type": "string"
          },
          "changed": {
            "description": "The first code differs from the belief before.",
            "title": "Changed",
            "type": "boolean"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          },
          "first": {
            "$ref": "#/$defs/Code"
          },
          "kind": {
            "enum": [
              "h0",
              "h1",
              "h2",
              "answer"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "first",
          "cause",
          "account",
          "confidence",
          "changed",
          "cost_usd"
        ],
        "title": "Belief",
        "type": "object"
      },
      "Code": {
        "additionalProperties": false,
        "description": "One occurrence or finding code and its label.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "code",
          "label"
        ],
        "title": "Code",
        "type": "object"
      },
      "Comparison": {
        "additionalProperties": false,
        "description": "The answer set against the verdict.",
        "properties": {
          "agent_occurrence": {
            "items": {
              "$ref": "#/$defs/MarkedCode"
            },
            "title": "Agent Occurrence",
            "type": "array"
          },
          "finding_precision_10": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finding Precision 10"
          },
          "finding_recall_10": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finding Recall 10"
          },
          "findings_agent_only": {
            "items": {
              "$ref": "#/$defs/Code"
            },
            "title": "Findings Agent Only",
            "type": "array"
          },
          "findings_both": {
            "items": {
              "$ref": "#/$defs/Code"
            },
            "title": "Findings Both",
            "type": "array"
          },
          "findings_ntsb_only": {
            "items": {
              "$ref": "#/$defs/Code"
            },
            "title": "Findings Ntsb Only",
            "type": "array"
          },
          "ntsb_occurrence": {
            "items": {
              "$ref": "#/$defs/MarkedCode"
            },
            "title": "Ntsb Occurrence",
            "type": "array"
          }
        },
        "required": [
          "agent_occurrence",
          "ntsb_occurrence",
          "findings_both",
          "findings_ntsb_only",
          "findings_agent_only",
          "finding_precision_10",
          "finding_recall_10"
        ],
        "title": "Comparison",
        "type": "object"
      },
      "DocumentChoice": {
        "additionalProperties": false,
        "description": "One document of the docket and what the agent did with it.",
        "properties": {
          "decision": {
            "description": "What the agent did with the document. read and skipped are its choices over a document it was offered. scan_only is a scan the reader could not turn into text. not_offered is a document not on offer at this read choice, other than a scan (see not_offered_reason); it never means a withheld document. A docket document that holds the NTSB's probable cause makes the whole case not coded (leak) instead.",
            "enum": [
              "read",
              "skipped",
              "scan_only",
              "not_offered"
            ],
            "title": "Decision",
            "type": "string"
          },
          "not_offered_reason": {
            "anyOf": [
              {
                "enum": [
                  "not_pdf",
                  "photo_only",
                  "fetch_failed",
                  "already_read",
                  "over_size_limit"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Why the document was not on offer at this read choice; set only when decision is not_offered, else None. not_pdf, photo_only and fetch_failed: the docket reader could not offer it as text. already_read: it was read at an earlier read choice, and a document read is never offered again. over_size_limit: a readable document left out by the prompt-size ceiling of decision 0152.",
            "title": "Not Offered Reason"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The agent's expected_effect, after the names step.",
            "title": "Note"
          },
          "pages": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The document's page count. None when not recorded.",
            "title": "Pages"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "title": {
            "description": "After the names step.",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "position",
          "title",
          "decision",
          "note",
          "pages",
          "not_offered_reason"
        ],
        "title": "DocumentChoice",
        "type": "object"
      },
      "Facts": {
        "additionalProperties": false,
        "description": "The case's plain facts.",
        "properties": {
          "documents_listed": {
            "title": "Documents Listed",
            "type": "integer"
          },
          "documents_read": {
            "title": "Documents Read",
            "type": "integer"
          },
          "injury_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "highestInjuryLevel.",
            "title": "Injury Level"
          },
          "kind_of_flight": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "aircrafts[0].ownerOperators[0].flightOperationType.",
            "title": "Kind Of Flight"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "eventStateOrRegion.",
            "title": "State"
          }
        },
        "required": [
          "state",
          "kind_of_flight",
          "injury_level",
          "documents_read",
          "documents_listed"
        ],
        "title": "Facts",
        "type": "object"
      },
      "Lookup": {
        "additionalProperties": false,
        "description": "One coding lookup the agent made.",
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "tool",
          "arguments",
          "cost_usd"
        ],
        "title": "Lookup",
        "type": "object"
      },
      "MarkedCode": {
        "additionalProperties": false,
        "description": "An occurrence code marked against the other list: same place, other place, or absent.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "mark": {
            "enum": [
              "same_place",
              "other_place",
              "not_in_other"
            ],
            "title": "Mark",
            "type": "string"
          }
        },
        "required": [
          "code",
          "label",
          "mark"
        ],
        "title": "MarkedCode",
        "type": "object"
      },
      "NotCoded": {
        "additionalProperties": false,
        "description": "Why a case was not coded: its failure kind and one fixed plain sentence.",
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "sentence": {
            "description": "Chosen in code from NOT_CODED_SENTENCES, never failure text.",
            "title": "Sentence",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "sentence"
        ],
        "title": "NotCoded",
        "type": "object"
      },
      "ReadChoice": {
        "additionalProperties": false,
        "description": "One read-or-skip choice over the docket.",
        "properties": {
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          },
          "documents": {
            "items": {
              "$ref": "#/$defs/DocumentChoice"
            },
            "title": "Documents",
            "type": "array"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "step": {
            "enum": [
              "choice1",
              "choice2"
            ],
            "title": "Step",
            "type": "string"
          }
        },
        "required": [
          "step",
          "reason",
          "documents",
          "cost_usd"
        ],
        "title": "ReadChoice",
        "type": "object"
      },
      "Trail": {
        "additionalProperties": false,
        "description": "The agent's steps and their cost.",
        "properties": {
          "beliefs": {
            "items": {
              "$ref": "#/$defs/Belief"
            },
            "title": "Beliefs",
            "type": "array"
          },
          "lookups": {
            "items": {
              "$ref": "#/$defs/Lookup"
            },
            "title": "Lookups",
            "type": "array"
          },
          "read_choices": {
            "items": {
              "$ref": "#/$defs/ReadChoice"
            },
            "title": "Read Choices",
            "type": "array"
          },
          "total_usd": {
            "title": "Total Usd",
            "type": "number"
          }
        },
        "required": [
          "beliefs",
          "read_choices",
          "lookups",
          "total_usd"
        ],
        "title": "Trail",
        "type": "object"
      },
      "Verdict": {
        "additionalProperties": false,
        "description": "The NTSB's verdict.",
        "properties": {
          "cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cause"
          },
          "findings": {
            "items": {
              "$ref": "#/$defs/Code"
            },
            "title": "Findings",
            "type": "array"
          },
          "occurrence": {
            "items": {
              "$ref": "#/$defs/Code"
            },
            "title": "Occurrence",
            "type": "array"
          }
        },
        "required": [
          "occurrence",
          "findings",
          "cause"
        ],
        "title": "Verdict",
        "type": "object"
      },
      "Withheld": {
        "additionalProperties": false,
        "description": "The line that says when and how the case was coded.",
        "properties": {
          "coded_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }

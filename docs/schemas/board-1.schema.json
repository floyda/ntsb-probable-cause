            "description": "When the first call was sent, UTC.",
            "title": "Coded At"
          },
          "commit": {
            "title": "Commit",
            "type": "string"
          },
          "model": {
            "description": "The model asked for.",
            "title": "Model",
            "type": "string"
          },
          "prompt_version": {
            "title": "Prompt Version",
            "type": "string"
          },
          "providers": {
            "items": {
              "type": "string"
            },
            "title": "Providers",
            "type": "array"
          },
          "replied_models": {
            "items": {
              "type": "string"
            },
            "title": "Replied Models",
            "type": "array"
          }
        },
        "required": [
          "coded_at",
          "commit",
          "prompt_version",
          "model",
          "replied_models",
          "providers"
        ],
        "title": "Withheld",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "``cases/<case number>.json``: one closed case and its trail.",
    "properties": {
      "aircraft": {
        "$ref": "#/$defs/Aircraft"
      },
      "answer": {
        "anyOf": [
          {
            "$ref": "#/$defs/Answer"
          },
          {
            "type": "null"
          }
        ]
      },
      "case_number": {
        "title": "Case Number",
        "type": "string"
      },
      "closed_on": {
        "format": "date",
        "title": "Closed On",
        "type": "string"
      },
      "comparison": {
        "anyOf": [
          {
            "$ref": "#/$defs/Comparison"
          },
          {
            "type": "null"
          }
        ]
      },
      "facts": {
        "anyOf": [
          {
            "$ref": "#/$defs/Facts"
          },
          {
            "type": "null"
          }
        ],
        "description": "None when the record was unreachable."
      },
      "format": {
        "const": "board/1",
        "default": "board/1",
        "title": "Format",
        "type": "string"
      },
      "grade": {
        "enum": [
          "same_first",
          "same_codes_other_order",
          "different",
          "abstained",
          "not_coded",
          "awaiting_ntsb"
        ],
        "title": "Grade",
        "type": "string"
      },
      "mkey": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "The NTSB's internal case key; the docket link is built from it. None in a file written before the field existed.",
        "title": "Mkey"
      },
      "not_coded": {
        "anyOf": [
          {
            "$ref": "#/$defs/NotCoded"
          },
          {
            "type": "null"
          }
        ]
      },
      "took_days": {
        "description": "Days from the accident to closure.",
        "title": "Took Days",
        "type": "integer"
      },
      "trail": {
        "anyOf": [
          {
            "$ref": "#/$defs/Trail"
          },
          {
            "type": "null"
          }
        ]
      },
      "verdict": {
        "anyOf": [
          {
            "$ref": "#/$defs/Verdict"
          },
          {
            "type": "null"
          }
        ]
      },
      "withheld": {
        "anyOf": [
          {
            "$ref": "#/$defs/Withheld"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "format",
      "case_number",
      "mkey",
      "closed_on",
      "took_days",
      "aircraft",
      "grade",
      "facts",
      "withheld",
      "answer",
      "verdict",
      "comparison",
      "trail",
      "not_coded"
    ],
    "title": "CaseFile",
    "type": "object"
  },

# The recorder image needs pyproject.toml, uv.lock, README.md, LICENSE, src/ and apps/ only
# (Dockerfile, Task 12). Everything else is excluded so the build context stays small and
# nothing under data/ -- which is never in git either -- can reach a build layer.
data/
tests/
docs/
scripts/exploratory/
infra/
.git/
.claude/
.superpowers/
.venv/
**/__pycache__
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.sqlite*

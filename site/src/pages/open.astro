---
// The Open cases page (spec §8; S5 step 6c): counts only, from the export's `counts`, never a list
// of open cases (Andy, 2026-10-11). An open case enters the site only as a number (decision
// 0024). Short, so it has no rail.
import Panel from "../components/Panel.astro";
import Base from "../layouts/Base.astro";
import { exportDir, loadExport } from "../lib/export";
import { checkCounts, closureNights, openLines } from "../lib/open";
import { BOARD_START, closedLong } from "../lib/words";

const { index } = loadExport(exportDir());
checkCounts(index.counts, index.rows.length);
const lines = openLines(index.counts);
const nights = closureNights(index.counts);
// Written as strings: the formatter drops a space before an expression in running text.
const since = closedLong(BOARD_START);
const caption = `Cases closed each night since ${since}`;
const onBoard = `Cases closed since ${since} are on`;
---

<Base
    title="Open cases · Ellery"
    description="How many open cases are watched, how many have a docket so far, and how many closed each night."
    current="open"
>
    {/* Opens like the Path and Methods: a plain heading, then the counts (spec §8). */}
    <h1>Open cases</h1>
    <p class="lede">{lines.slice(0, 2).join(" ")}</p>
    <p>
        {lines.slice(2).join(" ")} {onBoard} <a href="/">the board</a>.
    </p>

    <Panel>
        <table>
            <caption>{caption}</caption>
            <thead>
                <tr>
                    <th scope="col">Night</th>
                    <th scope="col">Cases closed</th>
                </tr>
            </thead>
            <tbody>
                {nights.map((n) => (
                    <tr>
                        <td>{n.label}</td>
                        <td>{n.count}</td>
                    </tr>
                ))}
            </tbody>
        </table>
        {nights.length === 0 && <p>No case has closed yet.</p>}
    </Panel>
</Base>

<style>
    .lede {
        font-size: 1.1rem;
    }
    p {
        margin-block: 0 0.75rem;
    }
    table {
        border-collapse: collapse;
    }
    caption {
        text-align: left;
        font-weight: 700;
        padding-bottom: 0.5rem;
    }
    th,
    td {
        text-align: left;
        padding: 0.35rem 1.5rem 0.35rem 0;
        border-bottom: 1px solid var(--rule);
    }
    td:last-child,
    th:last-child {
        text-align: right;
        padding-right: 0;
        font-variant-numeric: tabular-nums;
    }
</style>

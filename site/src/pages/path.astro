---
// The Path page (spec §7): how the project decided what to build. The ladder, then the eight
// questions, each with its measured answer, the decision taken and its sources, then what could
// come next. Every figure is read from the numbers file by key; none is typed here.
import BeliefPath from "../components/BeliefPath.astro";
import ClosuresStrip from "../components/ClosuresStrip.astro";
import ExampleCase from "../components/ExampleCase.astro";
import FirstCodes from "../components/FirstCodes.astro";
import MissPairs from "../components/MissPairs.astro";
import Ladder from "../components/Ladder.astro";
import PageKinds from "../components/PageKinds.astro";
import PathStop from "../components/PathStop.astro";
import Sign from "../components/Sign.astro";
import Base from "../layouts/Base.astro";
import { exportDir, loadExport } from "../lib/export";
import { assertPathClaims } from "../lib/claims";
import { countOf, pointsOn, usd, withInterval } from "../lib/numbers";
import { entryLink } from "../lib/methods";
import { repoUrl } from "../lib/words";

const { index } = loadExport(exportDir());

// Question 2 says "no better than guessing" only while the no-docket interval holds the
// baseline's rate (plan Review Focus 5); a re-run that breaks this stops the build.
// Each worded claim (question 2's "no better than guessing", question 4's interval, question
// 7's "worse" and "about the same") stops the build when its figures no longer fit it.
assertPathClaims();

const R = "docs/results/";

// The Path's rail (spec §21 note, 2026-10-16): the ladder and the eight questions, by short names.
const places = [
    { id: "ladder", label: "The ladder" },
    { id: "answer-key", label: "1 · An answer key" },
    { id: "case-record", label: "2 · The case record" },
    { id: "docket", label: "3 · The docket" },
    { id: "scanned-pages", label: "4 · Scanned pages" },
    { id: "coding", label: "5 · Coding misses" },
    { id: "consistency", label: "6 · Consistency" },
    { id: "choosing", label: "7 · Choosing" },
    { id: "newly-closed", label: "8 · Newly closed" },
    { id: "next", label: "What could come next" },
];
---

<Base
    title="The path · Ellery"
    description="How the project decided what to build: eight questions, each with its measured answer and the decision taken."

    current="path"
    places={places}
>
    <h1>The path</h1>
    <p class="lede">
        How the project decided what to build. Four ways of coding an accident, each with more
        machinery than the one before, then the eight questions that led from one to the next. Every
        figure links to the results file and the script that produced it.
    </p>

    <section id="ladder" aria-labelledby="ladder-heading">
        <Sign>Four ways to code an accident</Sign>
        <h2 id="ladder-heading">The ladder</h2>
        <p>
            How often each way's first code matched the NTSB's, on held-out accidents, and what it
            cost. The whisker on each bar is its 95 percent interval.
        </p>
        <div class="panel">
            <Ladder id="ladder-top" />
        </div>
    </section>

    <PathStop
        id="answer-key"
        methods="answer-key"
        n={1}
        question="Is there an answer key nobody had to write?"
        decision="Score every answer by exact match against the NTSB's own codes, with no person or model grading it."
        results={[`${R}s1-bars.txt`]}
        scripts={["apps/eval/", "scripts/site_example_case.py"]}
    >
        <p>
            Yes. The NTSB codes every closed case: occurrence codes for what happened, in order,
            finding codes for why, and a one- or two-sentence probable cause.
        </p>
        <ExampleCase slot="figure" />
    </PathStop>

    <PathStop
        id="case-record"
        methods="ladder"
        n={2}
        question="Is the case record enough?"
        decision="Give the agent the docket: the documents the investigators gathered."
        results={[`${R}s32-claims-heldout.txt`, `${R}s1-baseline.txt`, `${R}s1-bars.txt`]}
        scripts={["scripts/s32_claims.py", "apps/eval/"]}
    >
        <p>
            No. With the recorded facts alone, the agent matched the NTSB's first code in{" "}
            {withInterval("ladder.no_docket.top1")}. Always guessing the commonest code matched in{" "}
            {withInterval("ladder.baseline.top1")}. The agent did no better than guessing.
        </p>
        <p>S1's one-shot ceiling, on an earlier stack, scored below that guess.</p>
        <Ladder id="ladder-q2" lit={["baseline", "no_docket"]} sentence={false} slot="figure" />
    </PathStop>

    <PathStop
        id="docket"
        methods="docket"
        n={3}
        question="Does reading the docket help?"
        decision="Build every version on the docket, then ask whether choosing what to read beats reading it all (question 7)."
        results={[`${R}s24-bars.txt`]}
        scripts={["apps/eval/"]}
    >
        <p>
            Yes. It is the largest gain on the ladder. It was first measured in S2.4, with the fixed
            pipeline's first version, before its coding tools: against the one-shot ceiling, the
            same model answering from the case record alone, reading the docket raised the
            first-code match by {pointsOn("q3.docket_gain")}.
        </p>
        <Ladder id="ladder-q3" lit={["fixed"]} sentence={false} slot="figure" />
    </PathStop>

    <PathStop
        id="scanned-pages"
        methods="scanned-pages"
        n={4}
        question="Does reading words in scanned pages help?"
        decision="Paused: transcription is off by default. It is a candidate to return as a measured improvement."
        results={[`${R}s26-armB-v2-dev.txt`, `${R}s26-page-kinds.txt`]}
        scripts={["apps/eval/", "scripts/page_kinds.py"]}
    >
        <p>
            On development cases it was not shown to help. Adding the words read from page images
            changed the first-code match by {pointsOn("q4.v2_gain")}, an interval that includes
            zero, and transcribing the pages cost far more than answering (decision{" "}
            <a
                href={repoUrl(
                    "docs/decisions/0120-qwen-stays-and-transcription-is-off-by-default.md",
                )}
            >
                0120
            </a>
            ).
        </p>
        <PageKinds slot="figure" />
    </PathStop>

    <PathStop
        id="coding"
        methods="coding"
        n={5}
        question="Are the misses about evidence or about coding?"
        decision="Coding guidance and an ordering check followed. Of five guidance rounds, three were dropped."
        results={[
            `${R}s26-occurrence-misses-dev.txt`,
            `${R}s5-occurrence-misses-s3-dev.txt`,
            "docs/rounds/",
        ]}
        scripts={["scripts/occurrence_misses.py"]}
    >
        <p>
            Mostly coding order. On development cases the fixed pipeline's first guess was somewhere
            in the NTSB's ordered sequence of codes in {countOf("q5.in_sequence")} cases, but was
            the NTSB's first code in only {countOf("q5.first_right")}.
        </p>
        <p>
            Later, on S3's fixed pipeline, the first guess was the NTSB's first code in{" "}
            {countOf("q5.s3.first_right")} cases, and somewhere in its sequence in{" "}
            {countOf("q5.s3.in_sequence")}. That pipeline added coding guidance, the coding tools
            and the ordering check, and read the documents' text only, where S2.6's run also read
            words from page images; so the change is not the guidance alone.
        </p>
        <div slot="figure" class="tables">
            <MissPairs
                listKey="q5.pairs"
                id="pairs-s26"
                caption="S2.6's fixed pipeline (text and words from page images): the commonest misses, the NTSB's first event and the pipeline's"
            />
            <MissPairs
                listKey="q5.s3.pairs"
                id="pairs-s3"
                caption="S3's fixed pipeline (guidance, coding tools, ordering check; text only): the commonest misses"
            />
        </div>
    </PathStop>

    <PathStop
        id="consistency"
        methods="consistency"
        n={6}
        question="How consistent is the answer key itself?"
        decision="Precedent alone cannot settle the first code, so the precedent tool waits for a measured second version, after the live board."
        results={[
            `${R}s3-coding-consistency-dev.txt`,
            `${R}s3-finding-consistency-dev.txt`,
            `${R}s5-one-sentence-dev.txt`,
        ]}
        scripts={[
            "scripts/exploratory/s3_coding_consistency.py",
            "scripts/exploratory/s3_finding_consistency.py",
            "scripts/exploratory/s5_one_sentence.py",
        ]}
    >
        <p>
            Cases whose NTSB probable-cause sentences match word for word share their first code in
            only {withInterval("q6.twins")}. Their flagged findings agree far more.
        </p>
        <p>
            This does not say the NTSB was inconsistent: the same sentence can follow accidents
            whose sequences of events differ. It bounds what any coder reading only the sentence
            could score.
        </p>
        <FirstCodes slot="figure" />
    </PathStop>

    <PathStop
        id="choosing"
        methods="choosing"
        n={7}
        question="Does choosing what to read beat reading everything?"
        decision="Not shown, so the loop is not warranted. Version 1 runs on the board unchanged, as the version being improved, and the fixed pipeline is the bar for the next."
        results={[
            `${R}s32-claims-heldout.txt`,
            `${R}s32-heldout-diagnosis.txt`,
            `${R}s5-belief-path-heldout.txt`,
            `${R}s3-noise-floor-dev.txt`,
        ]}
        scripts={[
            "scripts/s32_claims.py",
            "scripts/exploratory/s32_heldout_diagnosis.py",
            "scripts/exploratory/s5_belief_path.py",
            "scripts/s3_noise_floor.py",
        ]}
    >
        <p>
            No. On held-out cases the loop was worse on the first code, the top three and the
            findings. Against the fixed pipeline its first-code match was{" "}
            {pointsOn("q7.loop_vs_fixed")}.
        </p>
        <p>
            Its bill was about the same: {usd("ladder.loop.billed")} against the pipeline's{" "}
            {usd("ladder.fixed.billed")}.
        </p>
        <p>
            Reading the docket still mattered: on the first code, the same loop without it was{" "}
            {pointsOn("q7.no_docket_loss")}. The loop read every offered document in{" "}
            {countOf("q7.read_all")} cases that had documents on offer, and skipped most often on
            large fatal dockets.
        </p>
        <p>
            Most of the pipeline's lead came from its coding-tools step. Against the pipeline's
            first answer alone, before that step, the loop was {pointsOn("q7.loop_vs_answer")}{" "}
            (exploratory).
        </p>
        <p class="band">
            How far the same agent moves when run again: two identical runs on development cases
            differed by {pointsOn("q7.noise_band")}. This was measured on development cases, so it
            is not drawn on the ladder. Methods:{" "}
            <a href={entryLink("q7.noise_band")}>the run-twice band</a>.
        </p>
        <BeliefPath slot="figure" />
    </PathStop>

    <PathStop
        id="newly-closed"
        methods="board"
        n={8}
        question="Does it hold on newly closed cases?"
        decision="Code each newly closed case once, at closure, and show it beside the NTSB's codes as counts, never a percentage."
    >
        <p>The board answers this in public.</p>
        <ClosuresStrip rows={index.rows} slot="figure" />
    </PathStop>

    <section id="next" class="next" aria-labelledby="next-heading">
        <Sign>After version 1</Sign>
        <h2 id="next-heading">What could come next</h2>
        <p>Each would be run as a registered, measured experiment against the fixed pipeline.</p>
        <ul>
            <li>Transcription of scanned pages, back as a measured improvement.</li>
            <li>
                The precedent tool, which the agent questions (decision{" "}
                <a
                    href={repoUrl(
                        "docs/decisions/0140-the-precedent-tool-after-s4-as-a-measured-v2.md",
                    )}
                >
                    0140
                </a>
                ).
            </li>
            <li>The weather archive.</li>
            <li>The model comparison.</li>
        </ul>
        <p>
            When a second version of the agent runs, this site will show the first against the
            second on the same cases.
        </p>
    </section>
</Base>

<style>
    .lede {
        font-size: 1.1rem;
    }
    section[aria-labelledby="ladder-heading"],
    .next {
        display: grid;
        gap: 0.6rem;
        padding-block: var(--space-section);
    }
    .next {
        border-top: 1px solid var(--rule);
    }
    h2 {
        margin: 0;
    }
    /* Block margins only: main's children keep their centring margin (tokens.css). */
    p {
        margin-block: 0;
    }
    .band {
        color: var(--ink-muted);
    }
    .tables {
        display: grid;
        gap: 1rem;
    }
    .next ul {
        margin: 0;
        padding-left: 1.2rem;
    }
</style>

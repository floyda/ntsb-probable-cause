---
// The way back from a case or trail page (spec §21 note, 2026-10-16): to the board, and from a
// trail to its case. The arrow is drawn, not read: a screen reader hears "All closed cases".
interface Props {
    /** The case a trail belongs to; absent on a case page. */
    caseNumber?: string;
}

const { caseNumber } = Astro.props;
const links = [
    { href: "/#board", label: "All closed cases" },
    ...(caseNumber === undefined ? [] : [{ href: `/case/${caseNumber}/`, label: "This case" }]),
];
---

<nav class="back" aria-label="Back">
    <ul>
        {links.map((l) => (
            <li>
                <a href={l.href}>
                    <span aria-hidden="true">←</span> {l.label}
                </a>
            </li>
        ))}
    </ul>
</nav>

<style>
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
    }
    a {
        display: inline-block;
        padding-block: 0.3rem;
    }
</style>

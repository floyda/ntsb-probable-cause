---
// The foot of every page (spec §3.1; decision 0219): the copyright line, then the author, linking
// to his profile page, the repository, Methods and Open cases.
import { AUTHOR_URL, COPYRIGHT } from "../lib/site";
import { repoRoot } from "../lib/words";
---

<footer class="site-foot">
    <div class="inner">
        <p class="copy">{COPYRIGHT}</p>
        <ul>
            <li>
                <a href={AUTHOR_URL}>Built by Andy Floyd</a>
            </li>
            <li>
                <a href={repoRoot()}>The repository</a>
            </li>
            <li>
                <a href="/methods/">Methods</a>
            </li>
            <li>
                <a href="/open/">Open cases</a>
            </li>
        </ul>
    </div>
</footer>

<style>
    /* On the page's own ground, under a 2px rule (0219) that stops at the column's edges, as
       floyda.dev's does (decision 0222). */
    .site-foot {
        /* The same box as .page (tokens.css), so the rule's ends line up with the column's. */
        box-sizing: border-box;
        width: 100%;
        max-width: 72rem;
        margin: var(--space-section) auto 0;
        padding-inline: 1rem;
    }
    .inner {
        padding-block: 1.25rem 2rem;
        border-top: var(--section-rule);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem 1.5rem;
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: var(--mono-track);
        text-transform: uppercase;
    }
    .copy {
        margin: 0;
        color: var(--ink-muted);
    }
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.5rem;
    }
    a {
        display: inline-block;
        padding-block: 0.4rem;
        color: var(--ink);
    }
    a:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 2px;
    }
</style>

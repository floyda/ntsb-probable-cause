---
// One question's stop on the Path page (spec §7.2): the question, its measured answer, the
// decision taken from it, its figure where there is one, and its sources on GitHub.
import { methodsLink } from "../lib/methods";
import Sign from "./Sign.astro";
import { repoUrl } from "../lib/words";

interface Props {
    /** The short anchor (§12 item 12), e.g. "docket". */
    id: string;
    n: number;
    question: string;
    decision: string;
    /** Repository paths of the results files behind the answer. */
    results?: string[];
    /** Repository paths of the scripts that wrote them. */
    scripts?: string[];
    /** The Methods group or section holding this question's numbers (plan step 5 choice 1). */
    methods: string;
}

const { id, n, question, decision, results = [], scripts = [], methods } = Astro.props;
const measured = methodsLink(methods);
const name = (path: string): string => path.replace(/\/$/, "").split("/").at(-1) ?? path;
const sources = [
    { kind: "Results", paths: results },
    { kind: "Script", paths: scripts },
].filter((s) => s.paths.length > 0);
---

<section class="stop" id={id} aria-labelledby={`${id}-q`}>
    <Sign>Question {String(n)}</Sign>
    <h2 id={`${id}-q`}>{question}</h2>
    <div class="answer">
        <slot />
    </div>
    <p class="decision">
        <strong>Decision:</strong> {decision}
    </p>
    {Astro.slots.has("figure") && (
        <div class="figure panel">
            <slot name="figure" />
        </div>
    )}
    <p class="sources">
        {sources.map((s) => (
            <>
                {s.kind}:{" "}
                {s.paths.map((path, j) => (
                    <>
                        {j > 0 && ", "}
                        <a href={repoUrl(path)}>{name(path)}</a>
                    </>
                ))}
                {" · "}
            </>
        ))}
        <a href={measured}>How this was measured</a>
        {" · "}
        {/* Its forwarding page, whose preview card shows this question (S5 step 6c). */}
        <a href={`/path/${id}/`}>Link to this question</a>
    </p>
</section>

<style>
    .stop {
        display: grid;
        gap: 0.6rem;
        padding-block: var(--space-section);
        border-top: 1px solid var(--rule);
    }
    h2 {
        margin: 0;
    }
    .answer {
        display: grid;
        gap: 0.5rem;
    }
    .answer :global(p),
    .decision,
    .sources {
        margin: 0;
    }
    .sources {
        color: var(--ink-muted);
        font-size: 0.92rem;
        overflow-wrap: anywhere;
    }
    .figure {
        min-width: 0;
    }
</style>

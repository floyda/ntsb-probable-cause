---
// The top bar on every page (spec §21 note, 2026-10-16; decision 0219): a skip link for keyboard
// users, then the author's name, linking to his profile site, then ELLERY, the way to the first
// page, then the site's separate pages. The current page is marked by aria-current, the ink
// colour and an underline, so never by colour alone. Last comes the dark mode button, as on
// floyda.dev (decision 0222).
import { AUTHOR_HOME, PAGES, type PageId } from "../lib/site";

interface Props {
    current?: PageId | undefined;
}

const { current } = Astro.props;
const here = (id: PageId): "page" | undefined => (id === current ? "page" : undefined);
---

<a class="skip" href="#content">
    Skip to content
</a>
<header class="site-head">
    <div class="inner">
        <div class="brand">
            <a class="author" href={AUTHOR_HOME}>
                Andy Floyd
            </a>
            <span class="slash" aria-hidden="true">
                /
            </span>
            <a class="wordmark" href="/" aria-current={here("home")}>
                ELLERY
            </a>
        </div>
        <nav aria-label="Site">
            <ul>
                {PAGES.map((p) => (
                    <li>
                        <a href={p.href} aria-current={here(p.id)}>
                            {p.label}
                        </a>
                    </li>
                ))}
                {/* Shown only when public/theme.js has run; it also sets aria-pressed. Dark is
                    the default, so it is pressed until the reader chooses light. The mark
                    beside the words is hollow for light and filled for dark. */}
                <li class="theme">
                    <button
                        type="button"
                        class="theme-toggle"
                        data-theme-toggle
                        aria-pressed="false"
                    >
                        Dark mode
                    </button>
                </li>
            </ul>
        </nav>
    </div>
</header>

<style>
    .skip {
        position: absolute;
        left: 1rem;
        top: -10rem;
        z-index: 20;
        padding: 0.5rem 0.75rem;
        background: var(--sign);
        color: var(--sign-ink);
        font-weight: 700;
    }
    .skip:focus {
        top: 0.5rem;
    }
    /* On the page's own ground, over a 2px rule (0219). The rule stops at the column's edges,
       as floyda.dev's does (decision 0222). */
    .site-head {
        /* The same box as .page (tokens.css), so the bar's ends line up with the column's. */
        box-sizing: border-box;
        width: 100%;
        max-width: 72rem;
        margin-inline: auto;
        padding-inline: 1rem;
    }
    .inner {
        padding-block: 0.6rem;
        border-bottom: var(--section-rule);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.25rem 1.5rem;
    }
    .brand {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
    }
    /* Capitals by CSS, so a screen reader hears the name in normal case. */
    .author,
    .slash,
    nav a {
        font-family: var(--mono);
        font-size: 0.75rem;
        letter-spacing: var(--mono-track);
        text-transform: uppercase;
    }
    .author {
        padding-block: 0.55rem;
        color: var(--ink);
        font-weight: 600;
        text-decoration: none;
    }
    .author:hover {
        text-decoration: underline;
    }
    .slash {
        color: var(--ink-muted);
    }
    .wordmark {
        font-family: var(--board);
        font-weight: 700;
        font-size: 1.35rem;
        line-height: 1.15;
        letter-spacing: 0.06em;
        color: var(--ink);
        text-decoration: none;
        border-bottom: 1px solid currentColor;
    }
    ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0 1.25rem;
    }
    nav a {
        display: inline-block;
        padding-block: 0.55rem;
        color: var(--ink-muted);
        text-decoration: none;
        border-bottom: 2px solid transparent;
    }
    nav a:hover {
        color: var(--ink);
    }
    nav a[aria-current="page"] {
        color: var(--ink);
        border-bottom-color: var(--ink);
    }
    ul {
        align-items: center;
    }
    /* floyda.dev's button: a thin edge, and a round mark that fills when dark is on. */
    .theme-toggle {
        font: inherit;
        font-size: 0.85rem;
        line-height: 1.4;
        padding: 0.15rem 0.5rem;
        border: 1px solid var(--ink-muted);
        border-radius: 4px;
        background: none;
        color: var(--ink);
        cursor: pointer;
    }
    .theme-toggle::after {
        content: "";
        display: inline-block;
        width: 0.6em;
        height: 0.6em;
        margin-left: 0.5em;
        border: 1.5px solid currentColor;
        border-radius: 50%;
        vertical-align: 0.02em;
    }
    .theme-toggle[aria-pressed="true"]::after {
        background: var(--sign);
        border-color: var(--sign);
    }
    /* Without the script the button could do nothing, so it is not shown. */
    :global(html:not([data-js])) .theme {
        display: none;
    }
    a:focus-visible,
    button:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 2px;
    }
</style>

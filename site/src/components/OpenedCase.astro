---
// One case: the agent's coding beside the NTSB's (spec §5), in plain type, from the export alone.
import type { CaseFile, Code, MarkedCode } from "../lib/board-case-types";
import { differenceSentence, docketUrl, factsLine, withheldLine } from "../lib/words";

interface Props {
    kase: CaseFile;
}

const { kase } = Astro.props;
const answer = kase.answer;
const verdict = kase.verdict;
const comparison = kase.comparison;
const notCoded = kase.grade === "not_coded";
const abstained = kase.grade === "abstained";
const docket = docketUrl(kase.mkey);
const withheld = withheldLine(kase);

const MARK_WORDS: Record<MarkedCode["mark"], string> = {
    same_place: "same place",
    other_place: "another place",
    not_in_other: "not in the other list",
};

const agentCauseHeading = abstained ? "The agent's reason for not answering" : "The agent's cause";
const agentCause = notCoded ? "Not coded." : (answer?.cause ?? "No answer.");
const ntsbCause = verdict?.cause ?? "Not yet published.";

function whyEmpty(side: "agent" | "ntsb"): string {
    if (side === "agent") return notCoded ? "Not coded." : "No answer.";
    return "Not yet published.";
}

const agentCodes: readonly MarkedCode[] = comparison?.agent_occurrence ?? [];
const ntsbCodes: readonly MarkedCode[] = comparison?.ntsb_occurrence ?? [];
// Without a comparison (awaiting the NTSB, or not coded) the agent's own list still shows.
const agentPlain: readonly Code[] = comparison === null ? (answer?.occurrence ?? []) : [];
const ntsbPlain: readonly Code[] = comparison === null ? (verdict?.occurrence ?? []) : [];

const findingGroups: { heading: string; codes: readonly Code[] }[] = comparison
    ? [
          { heading: "Both named", codes: comparison.findings_both },
          { heading: "Only the NTSB named", codes: comparison.findings_ntsb_only },
          { heading: "Only the agent named", codes: comparison.findings_agent_only },
      ]
    : [];
---

<article class="opened" id="opened" data-case={kase.case_number}>
    <ul class="facts">
        {factsLine(kase).map((item) => (
            <li>{item}</li>
        ))}
    </ul>

    <p class="difference">{differenceSentence(kase)}</p>

    <div class="pair">
        <section>
            <h3>{agentCauseHeading}</h3>
            <p>{agentCause}</p>
        </section>
        <section>
            <h3>The NTSB's cause</h3>
            <p>{ntsbCause}</p>
        </section>
    </div>

    <h3>
        What happened <span class="term">· NTSB occurrence codes</span>
    </h3>
    <div class="pair">
        <section>
            <h4>The agent's order</h4>
            {agentCodes.length > 0 ? (
                <ol>
                    {agentCodes.map((c) => (
                        <li>
                            {c.label} <span class="placed">· {MARK_WORDS[c.mark]}</span>
                        </li>
                    ))}
                </ol>
            ) : agentPlain.length > 0 ? (
                <ol>
                    {agentPlain.map((c) => (
                        <li>{c.label}</li>
                    ))}
                </ol>
            ) : (
                <p>{whyEmpty("agent")}</p>
            )}
        </section>
        <section>
            <h4>The NTSB's order</h4>
            {ntsbCodes.length > 0 ? (
                <ol>
                    {ntsbCodes.map((c) => (
                        <li>
                            {c.label} <span class="placed">· {MARK_WORDS[c.mark]}</span>
                        </li>
                    ))}
                </ol>
            ) : ntsbPlain.length > 0 ? (
                <ol>
                    {ntsbPlain.map((c) => (
                        <li>{c.label}</li>
                    ))}
                </ol>
            ) : (
                <p>{whyEmpty("ntsb")}</p>
            )}
        </section>
    </div>

    <h3>
        Why it happened <span class="term">· NTSB findings</span>
    </h3>
    {findingGroups.length > 0 ? (
        <div class="triple">
            {findingGroups.map((group) => (
                <section>
                    <h4>{group.heading}</h4>
                    {group.codes.length > 0 ? (
                        <ul>
                            {group.codes.map((c) => (
                                <li>{c.label}</li>
                            ))}
                        </ul>
                    ) : (
                        <p>None.</p>
                    )}
                </section>
            ))}
        </div>
    ) : (
        <p>{notCoded ? "Not coded." : "The NTSB has not published its findings yet."}</p>
    )}

    {withheld !== null && <p class="withheld">{withheld}</p>}
    {docket !== null && (
        <p class="sources">
            Sources: <a href={docket}>the case's evidence files</a>
            <span class="term"> · the docket</span>
        </p>
    )}
</article>

<style>
    .opened {
        display: grid;
        gap: 1rem;
    }
    .facts {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 0.75rem;
        color: var(--ink-muted);
    }
    .difference {
        font-size: 1.15rem;
        margin: 0;
    }
    .pair,
    .triple {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
    .pair > section,
    .triple > section {
        min-width: 0;
    }
    h3,
    h4 {
        margin: 0;
        text-wrap: balance;
    }
    h4 {
        font-size: 1rem;
        color: var(--ink-muted);
    }
    p,
    ol,
    ul {
        margin: 0.25rem 0 0;
    }
    .term,
    .placed {
        color: var(--ink-muted);
        font-size: 0.9em;
        font-weight: 400;
    }
    .withheld,
    .sources {
        color: var(--ink-muted);
        font-size: 0.95rem;
    }
    a {
        color: inherit;
    }
</style>

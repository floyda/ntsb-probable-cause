---
// A white panel with a thin edge, for a figure or a list of codes (spec §21 note of 2026-10-16):
// it sets the figure apart from the pale page around it. The edge is decoration, not a control.
interface Props {
    /** A label for the panel when it holds a figure that has none of its own. */
    label?: string;
}

const { label } = Astro.props;
---

<div class="panel" role={label === undefined ? undefined : "group"} aria-label={label}>
    <slot />
</div>

<style>
    .panel {
        display: grid;
        gap: 0.75rem;
        min-width: 0;
        padding: 0.9rem;
        border: 1px solid var(--panel-edge);
        border-radius: 4px;
        background: var(--paper);
    }
</style>

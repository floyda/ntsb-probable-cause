---
// The rail of places within a page (spec §21 note, 2026-10-16): in the right margin from 1000px,
// a strip of tabs across the top below that. It is a list of real links, complete without script;
// scripts/rail.ts only marks the place being read. The mark is bold, the ink colour and a bar or a
// filled tab, never colour alone.
import { checkPlaces, type Place } from "../lib/site";

interface Props {
    places: readonly Place[];
}

const places = checkPlaces(Astro.props.places);
// A place's leading number ("1 · The question") is set in amber (decision 0219).
const parts = (label: string): { n: string; rest: string } => {
    const found = /^(\d+)(\s.*)$/.exec(label);
    return found === null ? { n: "", rest: label } : { n: found[1] ?? "", rest: found[2] ?? "" };
};
---

<nav class="rail" aria-label="On this page">
    <p class="rail-title" aria-hidden="true">
        On this page
    </p>
    <ol>
        {places.map((p) => (
            <li>
                <a href={`#${p.id}`} data-place={p.id}>
                    {parts(p.label).n !== "" && <span class="n">{parts(p.label).n}</span>}
                    {parts(p.label).rest}
                </a>
            </li>
        ))}
    </ol>
</nav>

<style>
    /* Below 1000px: a strip of tabs, sticky at the top, scrolling sideways inside itself. */
    .rail {
        position: sticky;
        top: 0;
        z-index: 5;
        margin-inline: -1rem;
        padding: 0.45rem 1rem;
        background: var(--ground);
        border-bottom: 1px solid var(--rule);
    }
    .rail-title {
        display: none;
    }
    ol {
        list-style: none;
        margin: 0;
        /* Room for a focused tab's ring, which the strip's own scrolling would otherwise clip. */
        padding: 4px;
        display: flex;
        gap: 0.4rem;
        overflow-x: auto;
        scrollbar-width: none;
    }
    a {
        display: block;
        white-space: nowrap;
        min-height: 2rem;
        padding: 0.35rem 0.6rem;
        border: 1px solid var(--rule);
        border-radius: 3px;
        color: var(--ink-muted);
        /* floyda.dev's label face, in capitals (0219). */
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: var(--mono-track);
        text-transform: uppercase;
        text-decoration: none;
    }
    .n {
        color: var(--amber-text);
        font-weight: 600;
    }
    /* On the marked tab the number takes the tab's own colour: amber would not read on ink. */
    a.on .n {
        color: inherit;
    }
    a:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 2px;
    }
    a.on {
        background: var(--ink);
        border-color: var(--ink);
        color: var(--ground);
        font-weight: 700;
    }

    /* From 1000px: a column in the right margin, sticky, with a rule and a bar for the mark. */
    @media (min-width: 1000px) {
        .rail {
            grid-column: 2;
            grid-row: 1;
            align-self: start;
            top: 1.5rem;
            margin: 0;
            padding: 0.5rem 0 0;
            background: none;
            border: 0;
        }
        .rail-title {
            display: block;
            margin: 0 0 0.6rem;
            color: var(--ink-muted);
            font-family: var(--mono);
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: var(--mono-track);
            text-transform: uppercase;
        }
        ol {
            display: grid;
            gap: 0;
            padding: 0;
            overflow: visible;
            border-left: 2px solid var(--rule);
        }
        a {
            white-space: normal;
            min-height: 0;
            margin-left: -2px;
            padding: 0.4rem 0 0.4rem 0.8rem;
            border: 0;
            border-left: 2px solid transparent;
            border-radius: 0;
        }
        a.on {
            background: none;
            color: var(--ink);
            border-left-color: var(--ink);
        }
        a.on .n {
            color: var(--amber-text);
        }
        /* On the first page the rail starts in the opening band and scrolls away with it,
           then fades in here once the reader reaches the next section (scripts/rail.ts). */
        .rail.rides {
            position: static;
        }
        .rail.arrives {
            animation: rail-in 0.3s ease-out;
        }
        @keyframes rail-in {
            from {
                opacity: 0;
            }
        }
        @media (prefers-reduced-motion: reduce) {
            .rail.arrives {
                animation: none;
            }
        }
    }
</style>
